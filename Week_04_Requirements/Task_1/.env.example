API_KEY=replace-with-a-new-rotated-key

# Optional: set this when using an OpenAI-compatible API endpoint.
# OPENAI_BASE_URL=https://api.example.com/v1

# The assignment's three distinct models are used by default.
# EXTRACTION_MODEL=gpt-6-luna
# NORMALIZATION_MODEL=gpt-5.4-nano
# REVIEW_MODEL=gpt-5.6-luna

# Optional request and chunk controls. Defaults: extraction/review 180 seconds,
# normalization 300 seconds. Role-specific values override the global timeout.
# OPENAI_TIMEOUT_SECONDS=240
# NORMALIZE_TIMEOUT_SECONDS=300
# OPENAI_MAX_RETRIES=2
# CHUNK_SIZE_CHARS=12000
# CHUNK_OVERLAP_CHARS=800
